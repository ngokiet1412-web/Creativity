     "line": 1
    },
    {
     "file": "local/voice/SC11_03_CAPY.wav",
     "t0": 39.92,
     "who": "CAPY",
     "line": 2
    }
   ]
  },
  "SC12": {
   "length": 37.998,
   "marks": {
    "start": 0.0,
    "open.s": 0.6,
    "open.e": 1.8,
    "q.s": 1.8,
    "q.e": 8.88,
    "ks.s": 9.63,
    "ks.e": 34.998,
    "hold.s": 34.998,
    "hold.e": 36.798,
    "end": 37.998,
    "sig.s": 11.142,
    "epc.s": 20.982,
    "man.s": 27.51
   },
   "cues": [
    {
     "who": "CAPY",
     "t0": 1.8,
     "t1": 5.808,
     "text": "Nhưng tui học ô tô, tui muốn tìm ECU cơ!",
     "line": 0
    },
    {
     "who": "CAPY",
     "t0": 5.928,
     "t1": 8.88,
     "text": "Hệ thống thủy lực này có điện tử không?",
     "line": 0
    },
    {
     "who": "KS",
     "t0": 9.63,
     "t1": 11.022,
     "text": "Có.",
     "line": 1
    },
    {
     "who": "KS",
     "t0": 11.142,
     "t1": 20.862,
     "text": "Một số tín hiệu vận hành từ động cơ, cảm biến và bộ điều khiển được dùng để phối hợp công suất động cơ với yêu cầu thủy lực, điều khiển van điện từ và chế độ làm việc.",
     "line": 1
    },
    {
     "who": "KS",
     "t0": 20.982,
     "t1": 27.39,
     "text": "Ở hệ CLSS, LS/PC và EPC là những đầu mối cần học kỹ.",
     "line": 1
    },
    {
     "who": "KS",
     "t0": 27.51,
     "t1": 34.998,
     "text": "Nhưng sơ đồ dây, cổng điện và hiệu chỉnh phải tra đúng shop manual của phiên bản máy, chứ không đoán theo một ảnh trên mạng.",
     "line": 1
    }
   ],
   "voices": [
    {
     "file": "local/voice/SC12_01_CAPY.wav",
     "t0": 1.8,
     "who": "CAPY",
     "line": 0
    },
    {
     "file": "local/voice/SC12_02_KS.wav",
     "t0": 9.63,
     "who": "KS",
     "line": 1
    }
   ]
  },
  "SC13": {
   "length": 42.062,
   "marks": {
    "start": 0.0,
    "open.s": 0.6,
    "open.e": 1.8,
    "q.s": 1.8,

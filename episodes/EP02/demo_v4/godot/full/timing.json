   "cues": [
    {
     "who": "CAPY",
     "t0": 2.6,
     "t1": 4.04,
     "text": "Để tui tổng kết nha!",
     "line": 0
    },
    {
     "who": "CAPY",
     "t0": 4.34,
     "t1": 9.352,
     "text": "Động cơ cho năng lượng, hai bơm biến thành dòng dầu, CLSS giúp điều chỉnh theo tải,",
     "line": 0
    },
    {
     "who": "CAPY",
     "t0": 9.652,
     "t1": 12.521,
     "text": "van phân phối, xi lanh và mô tơ tạo chuyển động.",
     "line": 0
    },
    {
     "who": "CAPY",
     "t0": 12.821,
     "t1": 15.929,
     "text": "Dầu còn phải về lọc, làm mát, có van bảo vệ nữa.",
     "line": 0
    },
    {
     "who": "CAPY",
     "t0": 16.229,
     "t1": 19.812,
     "text": "Hóa ra không phải cái gầu khỏe — mà nguyên hệ thống đang phối hợp!",
     "line": 0
    },
    {
     "who": "KS",
     "t0": 20.562,
     "t1": 21.288,
     "text": "Chính xác.",
     "line": 1
    },
    {
     "who": "KS",
     "t0": 21.588,
     "t1": 23.743,
     "text": "Và đó mới là bản đồ tổng thể.",
     "line": 1
    },
    {
     "who": "KS",
     "t0": 24.043,
     "t1": 28.34,
     "text": "Muốn giải mã đến từng cổng, từng spool hay mã lỗi của PC200-8,",
     "line": 1
    },
    {
     "who": "KS",
     "t0": 28.64,

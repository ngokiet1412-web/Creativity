    "warn.s": 29.233
   },
   "cues": [
    {
     "who": "CAPY",
     "t0": 1.6,
     "t1": 5.183,
     "text": "Ủa, gầu gặp cục đá cứng quá thì áp suất cứ tăng mãi sao?",
     "line": 0
    },
    {
     "who": "CAPY",
     "t0": 5.483,
     "t1": 6.686,
     "text": "Nghe sợ à nha!",
     "line": 0
    },
    {
     "who": "KS",
     "t0": 7.436,
     "t1": 12.448,
     "text": "Hệ thống cần van giới hạn áp và các chức năng bảo vệ để tránh vượt giới hạn thiết kế.",
     "line": 1
    },
    {
     "who": "KS",
     "t0": 12.748,
     "t1": 16.569,
     "text": "PC200-8 có các mạch với mức áp thiết kế khác nhau.",
     "line": 1
    },
    {
     "who": "KS",
     "t0": 16.869,
     "t1": 21.167,
     "text": "Tài liệu hãng nêu áp cài đặt relief danh định cho mạch công tác, mạch di chuyển,",
     "line": 1
    },
    {
     "who": "KS",
     "t0": 21.467,
     "t1": 25.288,
     "text": "mạch quay toa và pilot; không nên gộp thành một con số cho mọi mạch.",
     "line": 1
    },
    {
     "who": "KS",
     "t0": 25.588,
     "t1": 28.933,
     "text": "Ngoài ra còn có giải pháp chống trôi hoặc giữ tải cho cần.",
     "line": 1
    },
    {
     "who": "KS",
     "t0": 29.233,
     "t1": 33.531,
     "text": "Tuy nhiên đừng bao giờ tự nới van relief hay sờ đường dầu áp cao để thử.",
     "line": 1
    },
    {
     "who": "CAPY",
     "t0": 34.281,
     "t1": 38.579,
     "text": "Vậy mấy cái van an toàn mới là đội bảo vệ của dàn cơ bắp thủy lực!",
     "line": 2
    }
   ]
  },

    "oil.s": 8.852,
    "pin.s": 15.19
   },
   "cues": [
    {
     "who": "KS",
     "t0": 1.8,
     "t1": 6.098,
     "text": "Cần nâng hạ bằng các xi lanh cần; tay gầu tiến lùi nhờ xi lanh tay gầu;",
     "line": 0
    },
    {
     "who": "KS",
     "t0": 6.398,
     "t1": 8.552,
     "text": "gầu cuộn hoặc mở bằng xi lanh gầu.",
     "line": 0
    },
    {
     "who": "KS",
     "t0": 8.852,
     "t1": 11.483,
     "text": "Dầu vào một khoang tạo lực làm piston dịch chuyển,",
     "line": 0
    },
    {
     "who": "KS",
     "t0": 11.783,
     "t1": 14.89,
     "text": "còn dầu ở khoang còn lại phải có đường thoát thích hợp.",
     "line": 0
    },
    {
     "who": "KS",
     "t0": 15.19,
     "t1": 16.869,
     "text": "Qua các chốt và tay đòn,",
     "line": 0
    },
    {
     "who": "KS",
     "t0": 17.169,
     "t1": 20.752,
     "text": "lực tịnh tiến của xi lanh biến thành chuyển động quay của các khâu.",
     "line": 0
    },
    {
     "who": "CAPY",
     "t0": 21.502,
     "t1": 25.324,
     "text": "Ủa vậy mình không được vẽ nguyên cái tay máy cong queo như cao su?",
     "line": 1
    },
    {
     "who": "KS",
     "t0": 26.074,
     "t1": 26.8,
     "text": "Chính xác!",
     "line": 2
    },
    {
     "who": "KS",
     "t0": 27.1,
     "t1": 31.874,
     "text": "Các khâu cứng quay quanh chốt, còn chiều dài xi lanh và góc khớp phải phù hợp hình học.",
     "line": 2
    }
   ]
  },
  "SC07": {
   "length": 39.383,
   "marks": {
    "start": 0.0,
    "open.s": 0.6,

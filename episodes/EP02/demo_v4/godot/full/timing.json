  "SC03": {
   "length": 50.69,
   "marks": {},
   "cues": [
    {
     "who": "KS",
     "line": 0,
     "text": "Động cơ diesel cấp công suất cơ học cho bơm.",
     "t0": 0.6,
     "t1": 4.392
    },
    {
     "who": "KS",
     "line": 0,
     "text": "Dữ liệu PC200-8 cho thấy động cơ Komatsu SAA6D107E-1;",
     "t0": 4.512,
     "t1": 11.952
    },
    {
     "who": "KS",
     "line": 0,
     "text": "phần bơm chính là loại piston thay đổi lưu lượng, có hai phần bơm để điều phối các nhu cầu làm việc.",
     "t0": 12.072,
     "t1": 18.48
    },
    {
     "who": "KS",
     "line": 0,
     "text": "Bên trong bơm piston hướng trục, khi góc đĩa nghiêng thay đổi, hành trình piston thay đổi theo.",
     "t0": 18.6,
     "t1": 25.152
    },
    {
     "who": "KS",
     "line": 0,
     "text": "Góc lớn hơn thường cho lưu lượng lớn hơn ở cùng tốc độ quay;",
     "t0": 25.272,
     "t1": 29.616
    },
    {
     "who": "KS",
     "line": 0,
     "text": "góc nhỏ hơn thì lưu lượng giảm.",
     "t0": 29.736,
     "t1": 32.568
    },
    {
     "who": "CAPY",
     "line": 1,
     "text": "Vậy ga máy tăng chưa chắc gầu lúc nào cũng chạy nhanh nhất?",
     "t0": 33.218,
     "t1": 37.034
    },
    {
     "who": "KS",
     "line": 2,
     "text": "Đúng.",
     "t0": 37.684,
     "t1": 39.1
    },
    {
     "who": "KS",
     "line": 2,
     "text": "Lưu lượng đến cơ cấu còn tùy bơm đang được điều khiển ra sao, van đang mở thế nào, tải và các giới hạn công suất.",
     "t0": 39.22,
     "t1": 46.348
    },
    {
     "who": "KS",
     "line": 2,
     "text": "Đó mới là điều thú vị.",
     "t0": 46.468,
     "t1": 48.94
    }
   ],
   "voices": [

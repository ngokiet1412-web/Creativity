   "cues": [
    {
     "who": "CAPY",
     "t0": 1.8,
     "t1": 6.336,
     "text": "Vậy nếu một ngày máy đào tự nhiên yếu, gầu lên chậm, có phải hư bơm không anh?",
     "line": 0
    },
    {
     "who": "KS",
     "t0": 7.086,
     "t1": 8.288,
     "text": "Chưa thể kết luận.",
     "line": 1
    },
    {
     "who": "KS",
     "t0": 8.588,
     "t1": 13.362,
     "text": "Phải tách khả năng động cơ thiếu công suất; điều khiển bơm hoặc tín hiệu LS bất thường;",
     "line": 1
    },
    {
     "who": "KS",
     "t0": 13.662,
     "t1": 18.436,
     "text": "van phân phối, pilot, rò rỉ bên trong, lọc dầu, nhiệt độ dầu; thậm chí ma sát cơ khí.",
     "line": 1
    },
    {
     "who": "KS",
     "t0": 18.736,
     "t1": 21.605,
     "text": "Quan trọng là biểu hiện khi nâng cần, co tay gầu,",
     "line": 1
    },
    {
     "who": "KS",
     "t0": 21.905,
     "t1": 24.774,
     "text": "quay toa và chạy xích có giống nhau hay khác nhau.",
     "line": 1
    },
    {
     "who": "KS",
     "t0": 25.074,
     "t1": 28.419,
     "text": "Đo và đối chiếu đúng quy trình an toàn mới khoanh vùng được,",
     "line": 1
    },
    {
     "who": "KS",
     "t0": 28.719,
     "t1": 31.112,
     "text": "chứ không thay bơm chỉ vì thấy máy chậm.",
     "line": 1
    }
   ]
  },

   },
   "cues": [
    {
     "who": "CAPY",
     "t0": 0.8,
     "t1": 1.764,
     "text": "Kĩiii sưuuu ơiiii!",
     "line": 0
    },
    {
     "who": "CAPY",
     "t0": 2.064,
     "t1": 2.79,
     "text": "Ê anh!",
     "line": 0
    },
    {
     "who": "CAPY",
     "t0": 3.09,
     "t1": 5.483,
     "text": "Bữa trước mình coi nguyên công trường rồi đó.",
     "line": 0
    },
    {
     "who": "CAPY",
     "t0": 5.783,
     "t1": 10.319,
     "text": "Mà tui vẫn thắc mắc: cái tay máy đào này nhìn như mấy miếng sắt nối với nhau,",
     "line": 0
    },
    {
     "who": "CAPY",
     "t0": 10.619,
     "t1": 13.25,
     "text": "sao nó nâng được một gầu đất nặng dữ vậy?",
     "line": 0
    },
    {
     "who": "CAPY",
     "t0": 13.55,
     "t1": 15.705,
     "text": "Nó có giấu cơ bắp trong đó hả?",
     "line": 0
    },
    {
     "who": "KS",
     "t0": 18.105,
     "t1": 19.545,
     "text": "Không có cơ bắp đâu.",
     "line": 1
    },
    {
     "who": "KS",
     "t0": 19.845,
     "t1": 22.0,
     "text": "Thứ đáng xem nằm bên trong thân máy:",
     "line": 1
    },
    {
     "who": "KS",
     "t0": 22.3,
     "t1": 25.169,
     "text": "một hệ thống thủy lực được điều khiển khá thông minh.",
     "line": 1
    },
    {
     "who": "KS",
     "t0": 25.469,
     "t1": 30.719,
     "text": "Hôm nay mình lấy Komatsu PC200-8 làm ví dụ, đi từ động cơ cho tới tận gầu,",
     "line": 1
    },
    {
     "who": "KS",
     "t0": 31.019,
     "t1": 33.412,
     "text": "rồi xem luôn quay toa và hai bánh xích.",
     "line": 1
    }
   ]
  },
  "SC02": {
   "length": 33.186,
   "marks": {
    "start": 0.0,
    "open.s": 0.6,
    "open.e": 2.2,
    "q.s": 2.2,
    "q.e": 6.498,
    "ks.s": 7.248,
    "ks.e": 30.486,
    "hold.s": 30.486,
    "hold.e": 31.986,
    "end": 33.186,
    "chain.s": 20.326
   },
   "cues": [
    {
     "who": "CAPY",
     "t0": 2.2,
     "t1": 6.498,
     "text": "Ủa, thủy lực có phải chỉ là một cái bơm nối với một cái xi lanh không?",
     "line": 0
    },
    {
     "who": "KS",
     "t0": 7.248,
     "t1": 12.021,
     "text": "Đơn giản hóa như vậy thì dễ học bước đầu, nhưng chưa đủ cho PC200-8.",
     "line": 1
    },
    {
     "who": "KS",
     "t0": 12.321,
     "t1": 16.381,
     "text": "Trên chiếc máy này còn có điều khiển tải, các đường dầu đến nhiều cơ cấu,",
     "line": 1
    },
    {
     "who": "KS",
     "t0": 16.681,
     "t1": 20.026,
     "text": "van phân phối, điều khiển pilot và tín hiệu điện tử phối hợp.",
     "line": 1
    },
    {
     "who": "KS",
     "t0": 20.326,
     "t1": 24.862,
     "text": "Mình sẽ lần theo dòng năng lượng trước: động cơ quay bơm; bơm đưa dầu vào hệ thống;",
     "line": 1
    },
    {
     "who": "KS",
     "t0": 25.162,
     "t1": 26.602,
     "text": "van điều khiển dòng dầu;",
     "line": 1
    },
    {
     "who": "KS",
     "t0": 26.902,
     "t1": 30.486,
     "text": "xi lanh hoặc mô tơ thủy lực biến năng lượng đó thành chuyển động.",
     "line": 1
    }
   ]
  },
  "SC06": {
   "length": 34.274,
   "marks": {
    "start": 0.0,
    "open.s": 0.6,
    "open.e": 1.8,
    "ks.s": 1.8,
    "ks.e": 20.752,
    "q.s": 21.502,
    "q.e": 25.324,
    "ks2.s": 26.074,
    "ks2.e": 31.874,
    "hold.s": 31.874,

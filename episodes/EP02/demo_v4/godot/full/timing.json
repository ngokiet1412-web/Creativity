    "trk.s": 20.917,
    "top.s": 24.917
   },
   "cues": [
    {
     "who": "CAPY",
     "t0": 1.6,
     "t1": 5.898,
     "text": "Nhưng động cơ với bơm ở thân trên, hai mô tơ di chuyển nằm dưới gầm xích.",
     "line": 0
    },
    {
     "who": "CAPY",
     "t0": 6.198,
     "t1": 9.543,
     "text": "Khi thân trên xoay, ống dầu không bị xoắn như mì gói hả?",
     "line": 0
    },
    {
     "who": "KS",
     "t0": 10.293,
     "t1": 14.59,
     "text": "Giữa hai phần có khớp quay phân phối dầu ở trung tâm, thường gọi center swivel joint.",
     "line": 1
    },
    {
     "who": "KS",
     "t0": 14.89,
     "t1": 20.617,
     "text": "Nó cho phép dẫn các mạch dầu xuống bộ phận di chuyển trong khi phần trên có thể quay tương đối với gầm.",
     "line": 1
    },
    {
     "who": "KS",
     "t0": 20.917,
     "t1": 24.024,
     "text": "Mỗi bên xích có mô tơ thủy lực và bộ truyền cuối,",
     "line": 1
    },
    {
     "who": "KS",
     "t0": 24.324,
     "t1": 27.669,
     "text": "nên có thể điều khiển hai bên để tiến, lùi hoặc đổi hướng.",
     "line": 1
    },
    {
     "who": "CAPY",
     "t0": 30.169,
     "t1": 33.514,
     "text": "Vậy bánh xích không phải cái hình chữ nhật xoay nguyên cục à!",
     "line": 2
    },
    {
     "who": "KS",
     "t0": 34.264,
     "t1": 34.752,
     "text": "Đúng.",
     "line": 3
    },
    {
     "who": "KS",
     "t0": 35.052,
     "t1": 37.445,
     "text": "Bánh dẫn quay, mắt xích chạy theo đường vòng,",
     "line": 3
    },
    {
     "who": "KS",
     "t0": 37.745,
     "t1": 40.376,
     "text": "và xe dịch chuyển do tương tác với mặt đất.",
     "line": 3
    }
   ]
  },
  "SC10": {
   "length": 27.81,
   "marks": {
    "start": 0.0,
    "open.s": 0.6,
    "open.e": 1.8,

   },
   "cues": [
    {
     "who": "CAPY",
     "t0": 1.8,
     "t1": 5.145,
     "text": "Nãy giờ toàn thấy dầu đi vô, vậy dầu đi đâu mất anh?",
     "line": 0
    },
    {
     "who": "KS",
     "t0": 5.895,
     "t1": 7.812,
     "text": "Nó tuần hoàn trong mạch thủy lực.",
     "line": 1
    },
    {
     "who": "KS",
     "t0": 8.112,
     "t1": 11.457,
     "text": "Sau khi thực hiện công việc, dầu quay về theo các đường hồi,",
     "line": 1
    },
    {
     "who": "KS",
     "t0": 11.757,
     "t1": 15.579,
     "text": "được làm mát và lọc phù hợp với đường mạch trước khi trở lại bình.",
     "line": 1
    },
    {
     "who": "KS",
     "t0": 15.879,
     "t1": 18.986,
     "text": "Dầu thủy lực không phải nhiên liệu để đốt trong xi lanh.",
     "line": 1
    },
    {
     "who": "KS",
     "t0": 19.286,
     "t1": 21.917,
     "text": "Nó truyền năng lượng, bôi trơn và giúp tản nhiệt,",
     "line": 1
    },
    {
     "who": "KS",
     "t0": 22.217,
     "t1": 24.61,
     "text": "nên độ sạch và nhiệt độ rất quan trọng.",
     "line": 1
    }
   ]
  },
  "SC11": {
   "length": 41.279,
   "marks": {
    "start": 0.0,
    "open.s": 0.6,
    "open.e": 1.6,
    "q.s": 1.6,
    "q.e": 6.686,

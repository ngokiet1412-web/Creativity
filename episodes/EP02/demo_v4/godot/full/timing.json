   "cues": [
    {
     "who": "CAPY",
     "t0": 1.8,
     "t1": 4.907,
     "text": "Nhưng tui học ô tô, tui muốn tìm ECU cơ!",
     "line": 0
    },
    {
     "who": "CAPY",
     "t0": 5.207,
     "t1": 7.6,
     "text": "Hệ thống thủy lực này có điện tử không?",
     "line": 0
    },
    {
     "who": "KS",
     "t0": 8.35,
     "t1": 8.838,
     "text": "Có.",
     "line": 1
    },
    {
     "who": "KS",
     "t0": 9.138,
     "t1": 11.531,
     "text": "Một số tín hiệu vận hành từ động cơ,",
     "line": 1
    },
    {
     "who": "KS",
     "t0": 11.831,
     "t1": 16.843,
     "text": "cảm biến và bộ điều khiển được dùng để phối hợp công suất động cơ với yêu cầu thủy lực,",
     "line": 1
    },
    {
     "who": "KS",
     "t0": 17.143,
     "t1": 19.774,
     "text": "điều khiển van điện từ và chế độ làm việc.",
     "line": 1
    },
    {
     "who": "KS",
     "t0": 20.074,
     "t1": 25.324,
     "text": "Ở hệ CLSS, LS/PC và EPC là những đầu mối cần học kỹ.",
     "line": 1
    },
    {
     "who": "KS",
     "t0": 25.624,
     "t1": 30.16,
     "text": "Nhưng sơ đồ dây, cổng điện và hiệu chỉnh phải tra đúng shop manual của phiên bản máy,",
     "line": 1
    },
    {
     "who": "KS",
     "t0": 30.46,
     "t1": 32.614,
     "text": "chứ không đoán theo một ảnh trên mạng.",
     "line": 1
    }
   ]

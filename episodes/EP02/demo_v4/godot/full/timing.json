  "SC04": {
   "length": 49.212,
   "marks": {},
   "cues": [
    {
     "who": "CAPY",
     "line": 0,
     "text": "Thế cái tên CLSS nghe như mật mã là gì anh?",
     "t0": 0.8,
     "t1": 4.832
    },
    {
     "who": "KS",
     "line": 1,
     "text": "Đó là hệ thống thủy lực tâm kín có cảm nhận tải.",
     "t0": 5.482,
     "t1": 9.25
    },
    {
     "who": "KS",
     "line": 1,
     "text": "Nói đơn giản: khi các tay điều khiển ở trung gian, máy không cần cấp lưu lượng lớn tới mọi cơ cấu.",
     "t0": 9.37,
     "t1": 16.042
    },
    {
     "who": "KS",
     "line": 1,
     "text": "Khi một cơ cấu cần làm việc, tín hiệu cảm nhận tải — gọi là LS — cùng các bộ điều chỉnh trên bơm giúp thay đổi lưu lượng phù hợp.",
     "t0": 16.162,
     "t1": 24.514
    },
    {
     "who": "KS",
     "line": 1,
     "text": "Van bù áp còn hỗ trợ phân chia dòng dầu khi nhiều cơ cấu làm việc cùng lúc.",
     "t0": 24.634,
     "t1": 29.578
    },
    {
     "who": "CAPY",
     "line": 2,
     "text": "À!",
     "t0": 30.228,
     "t1": 31.524
    },
    {
     "who": "CAPY",
     "line": 2,
     "text": "Không phải cứ nổ máy là bơm xả hết công suất đi khắp nơi.",
     "t0": 31.644,
     "t1": 35.676
    },
    {
     "who": "CAPY",
     "line": 2,
     "text": "Nó phải nghe xem ai đang cần dầu!",
     "t0": 35.796,
     "t1": 38.772
    },
    {
     "who": "KS",
     "line": 3,
     "text": "Hiểu theo mức nhập môn thì đúng.",
     "t0": 39.422,
     "t1": 42.11
    },
    {
     "who": "KS",
     "line": 3,
     "text": "Nhưng điều khiển thực tế có cả giới hạn công suất của động cơ và các điều kiện vận hành.",
     "t0": 42.23,
     "t1": 47.462
    }
   ],

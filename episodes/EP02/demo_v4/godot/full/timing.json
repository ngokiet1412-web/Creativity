  "SC05": {
   "length": 38.172,
   "marks": {},
   "cues": [
    {
     "who": "CAPY",
     "line": 0,
     "text": "Tui gạt cái cần nhỏ xíu trong cabin, sao điều khiển nổi một cái xi lanh bự vậy?",
     "t0": 0.8,
     "t1": 6.056
    },
    {
     "who": "KS",
     "line": 1,
     "text": "Tay điều khiển không tự đưa toàn bộ lưu lượng của bơm chính.",
     "t0": 6.706,
     "t1": 10.714
    },
    {
     "who": "KS",
     "line": 1,
     "text": "Trên PC200-8, mạch điều khiển pilot và cụm van chính thực hiện việc phân phối dầu đến các cơ cấu.",
     "t0": 10.834,
     "t1": 17.914
    },
    {
     "who": "KS",
     "line": 1,
     "text": "Gạt joystick làm thay đổi tín hiệu điều khiển, từ đó dịch chuyển phần tử van tương ứng để cho dầu đi đến khoang thích hợp của xi lanh hoặc mô tơ.",
     "t0": 18.034,
     "t1": 26.338
    },
    {
     "who": "CAPY",
     "line": 2,
     "text": "Tức là một tín hiệu nhỏ có thể điều khiển cả dòng năng lượng lớn?",
     "t0": 26.988,
     "t1": 31.26
    },
    {
     "who": "KS",
     "line": 3,
     "text": "Đúng, nhưng phải có nguồn năng lượng từ động cơ và bơm phía sau.",

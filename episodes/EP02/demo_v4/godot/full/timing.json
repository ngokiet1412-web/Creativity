   },
   "cues": [
    {
     "who": "CAPY",
     "t0": 1.6,
     "t1": 4.707,
     "text": "Nghe nói áp suất càng cao là máy càng mạnh, đúng hông?",
     "line": 0
    },
    {
     "who": "KS",
     "t0": 5.457,
     "t1": 6.66,
     "text": "Đúng một phần thôi.",
     "line": 1
    },
    {
     "who": "KS",
     "t0": 6.96,
     "t1": 8.876,
     "text": "Với một khoang xi lanh lý tưởng,",
     "line": 1
    },
    {
     "who": "KS",
     "t0": 9.176,
     "t1": 12.998,
     "text": "lực do áp suất tác dụng xấp xỉ F bằng p nhân diện tích A.",
     "line": 1
    },
    {
     "who": "KS",
     "t0": 13.298,
     "t1": 18.071,
     "text": "Muốn piston chuyển động nhanh, còn cần lưu lượng Q; tốc độ lý tưởng gần bằng Q chia A.",
     "line": 1
    },
    {
     "who": "KS",
     "t0": 18.371,
     "t1": 22.193,
     "text": "Nhưng lực tới răng gầu phụ thuộc thêm góc xi lanh, tay đòn, ma sát,",
     "line": 1
    },
    {
     "who": "KS",
     "t0": 22.493,
     "t1": 24.171,
     "text": "tổn thất và giới hạn bền.",
     "line": 1
    },
    {
     "who": "KS",
     "t0": 24.471,
     "t1": 28.769,
     "text": "Vì vậy không thể lấy lực piston rồi nói máy nâng được đúng chừng đó ký đất.",
     "line": 1
    },
    {
     "who": "CAPY",
     "t0": 29.519,
     "t1": 30.007,
     "text": "À!",
     "line": 2
    },
    {
     "who": "CAPY",
     "t0": 30.307,
     "t1": 33.652,
     "text": "Áp suất là điều kiện tạo lực, lưu lượng liên quan tốc độ.",
     "line": 2
    },
    {
     "who": "CAPY",
     "t0": 33.952,
     "t1": 36.583,
     "text": "Còn cơ cấu mới quyết định lực ra tới gầu!",
     "line": 2
    }
   ]
  },
  "SC08": {
   "length": 30.448,
